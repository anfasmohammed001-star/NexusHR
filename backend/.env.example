# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# When PostgreSQL is running, the server connects via DATABASE_URL or PG* variables.
# If PostgreSQL is not reachable, the backend gracefully falls back to persistent local storage (data/employees.sqlite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_management

# Optional explicit PostgreSQL parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=employee_management

