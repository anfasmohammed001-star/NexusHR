            "description": "Retrieve aggregate metrics: total employees, average salary, total payroll, and department counts."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns valid stats object', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property('totalEmployees');",
                  "    pm.expect(jsonData.data).to.have.property('averageSalary');",
                  "    pm.expect(jsonData.data).to.have.property('totalPayroll');",
