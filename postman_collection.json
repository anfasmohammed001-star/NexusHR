            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maya Lin\",\n  \"department\": \"Engineering\",\n  \"role\": \"Lead AI Engineer\",\n  \"salary\": 142000.00,\n  \"join_date\": \"2024-04-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"]
            },
            "description": "Create a new employee with valid payload."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Created employee contains generated ID and correct fields', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data.name).to.eql('Maya Lin');",
                  "    pm.expect(jsonData.data.salary).to.eql(142000);",
                  "    pm.collectionVariables.set('createdEmployeeId', jsonData.data.id.toString());",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
