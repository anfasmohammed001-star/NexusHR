    {
      "name": "2. Read Operations (GET)",
      "item": [
        {
          "name": "GET All Employees (Default)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"]
            },
            "description": "Retrieve all employees without query parameters."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains success true and employee array', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(Array.isArray(jsonData.data)).to.be.true;",
                  "    if (jsonData.data.length > 0) {",
                  "        pm.collectionVariables.set('employeeId', jsonData.data[0].id.toString());",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET All Employees (Search Query)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?search=Engineering",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"],
              "query": [
                {
                  "key": "search",
                  "value": "Engineering",
                  "description": "Case-insensitive search across name, department, role"
                }
              ]
            },
            "description": "Search employees by department, name, or role."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Every record matches search filter', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    jsonData.data.forEach(emp => {",
                  "        const combined = `${emp.name} ${emp.department} ${emp.role}`.toLowerCase();",
                  "        pm.expect(combined).to.include('engineering');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET All Employees (Sort By Salary DESC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?sortBy=salary&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"],
              "query": [
                {
                  "key": "sortBy",
                  "value": "salary",
                  "description": "Sort column (name|department|role|salary|join_date)"
                },
                {
                  "key": "order",
                  "value": "desc",
                  "description": "Sort direction (asc|desc)"
                }
              ]
            },
            "description": "Sort employees in descending order of salary."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Employees sorted in descending salary order', function () {",
                  "    const jsonData = pm.response.json();",
                  "    for (let i = 0; i < jsonData.data.length - 1; i++) {",
                  "        pm.expect(jsonData.data[i].salary).to.be.at.least(jsonData.data[i + 1].salary);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
